rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /user/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /plans/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}