{
  "private": true,
  "author": "Yan <i@yinyan.fr>",
  "repository": "github:yinyanfr/workout-goer",
  "homepage": "https://github.com/yinyanfr/workout-goer#readme",
  "scripts": {
    "dev": "umi dev",
    "build": "umi build && node scripts/build-sw.mjs",
    "postinstall": "umi setup",
    "setup": "umi setup",
    "start": "npm run dev",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,less}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,less}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "antd": "^6.3.6",
    "firebase": "^12.12.1",
    "umi": "^4.6.47",
    "workbox-webpack-plugin": "^7.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "elliptic": "^6.6.1",
    "path-to-regexp": "^8.2.0",
    "postcss": "^8.5.10",
    "send": "^0.19.1",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2",
    "@babel/runtime": "^7.27.6",
    "esbuild": "^0.25.0"
  }
}
